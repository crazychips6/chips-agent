{
  "title": "chips Agent",
  "description": "chips Agent 可观测性仪表盘 — LLM 调用、工具调用、系统健康",
  "tags": ["chips", "llm", "agent"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "query": "label_values(chips_llm_calls_total, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "title": "LLM 调用 QPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(chips_llm_calls_total{status=\"ok\"}[5m])",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "rate(chips_llm_calls_total{status=\"error\"}[5m])",
          "legendFormat": "error",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "thresholds": { "steps": [{ "color": "green" }, { "color": "red" }] }
        }
      }
    },
    {
      "title": "LLM 延迟 P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(chips_llm_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chips_llm_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(chips_llm_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Token 消耗速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(chips_llm_tokens_total{token_type=\"prompt\"}[5m])",
          "legendFormat": "prompt",
          "refId": "A"
        },
        {
          "expr": "rate(chips_llm_tokens_total{token_type=\"completion\"}[5m])",
          "legendFormat": "completion",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "token/s"
        }
      }
    },
    {
      "title": "累计费用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(chips_llm_cost_total) by (model)",
          "legendFormat": "{{ model }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "usd"
        }
      }
    },
    {
      "title": "错误率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(chips_llm_errors_total[5m]) / rate(chips_llm_calls_total[5m]) * 100",
          "legendFormat": "error_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "工具调用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(chips_tool_calls_total[5m])",
          "legendFormat": "{{ tool_name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "title": "活跃会话数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "chips_session_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "组件健康状态",
      "type": "table",
      "gridPos": { "h": 4, "w": 8, "x": 4, "y": 24 },
      "targets": [
        {
          "expr": "chips_deployment_state",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 2 }
              ]
            }
          }
        }
      }
    }
  ]
}
